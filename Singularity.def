Bootstrap: docker
From: ubuntu:20.04

%help
    This Singularity container runs the Attention-Mechanism project.

%labels
    Author Max Corbett
    Version 1.0

%environment
    # Set environment variables
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    # Update and install dependencies
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        g++ \
        libomp-dev \
        libboost-all-dev \
        git \
        wget \
        python3 \
        python3-pip

    # Install Python dependencies if needed
    pip3 install numpy matplotlib

    # Copy project files into the container
    mkdir -p /opt/attention-mechanism
    cp -r /path/to/your/project/* /opt/attention-mechanism/

    # Build the project
    cd /opt/attention-mechanism
    mkdir build && cd build
    cmake ..
    make

%runscript
    # Default command to run the project
    cd /opt/attention-mechanism/build
    ./main